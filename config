[cpu]
command=./cpu
markup=pango
interval=1

[ram]
command=./ram
markup=pango
interval=1

[brightness]
command=./brightness
markup=pango
interval=once
signal=2

[volume]
command=./volume
interval=once
signal=1

[disk]
command=./disk
interval=60

[wireless]
command=./wireless
markup=pango
interval=1

[battery]
command=./battery
markup=pango
interval=1

[load]
command=./load
markup=pango
interval=5

[date]
command=date "+%Y-%m-%d %H:%M:%S"
interval=1
