[cpu_temp]
command=./cpu_temp
markup=pango
interval=1

[ram_usage]
command=./ram_usage
markup=pango
interval=1

[brightness]
command=./brightness
markup=pango
interval=once
signal=2

[volume]
command=./volume
interval=once
signal=1

[disk]
command=./disk
interval=60

[wireless]
command=./wireless
markup=pango
interval=1

[load]
command=./load
markup=pango
interval=5

[date]
command=date "+%Y-%m-%d %H:%M:%S"
interval=1
